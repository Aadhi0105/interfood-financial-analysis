# --- Virtual environment ---
venv/
.venv/
env/
ENV/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
dist/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# --- Secrets / environment variables ---
.env
*.env
.env.*

# --- Generated data artefacts (reproducible from code) ---
data/interfood.db
data/*.db
data/*.sqlite

# --- Generated outputs ---
outputs/*.xlsx
outputs/charts/
outputs/**/*.png

# --- Streamlit ---
.streamlit/secrets.toml

# --- OS / editor cruft ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.vscode/
*.swp